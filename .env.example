LIFE_OS_DB_URL=sqlite:///./data/life_os.db
# Optional on localhost. Set a long random token before exposing the service beyond localhost.
# LIFE_OS_API_TOKEN=replace-with-a-long-random-token
LIFE_OS_BIND_HOST=127.0.0.1
LIFE_OS_BIND_PORT=8000
LIFE_OS_TIMEZONE=Europe/London
LIFE_OS_RAW_ACTIVITY_RETENTION_DAYS=45
LIFE_OS_ACTIVITY_SAMPLE_SECONDS=15

# Optional AdGuard Home integration.
LIFE_OS_ADGUARD_BASE_URL=
LIFE_OS_ADGUARD_USERNAME=
LIFE_OS_ADGUARD_PASSWORD=

# Optional academic reasoning provider.
# This adapter expects a chat-completions-compatible HTTP endpoint.
# Leave blank and Academic Brain stays in local extractive mode.
LIFE_OS_AI_BASE_URL=
LIFE_OS_AI_API_KEY=
LIFE_OS_AI_MODEL=
LIFE_OS_AI_TIMEOUT_SECONDS=60
